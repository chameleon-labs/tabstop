{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "maintenance"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "non-major dependencies"
    },
    {
      "matchPackageNames": [
        "@chameleon-labs/**"
      ],
      "groupName": "lattice design system"
    }
  ]
}
