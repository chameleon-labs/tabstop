{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "maintenance"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "non-major dependencies",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "matchPackageNames": [
        "@chameleon-labs/**"
      ],
      "groupName": "lattice design system"
    }
  ]
}
