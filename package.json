{
  "name": "tabstop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "oxlint --config .oxlintrc.json web/src web/scripts server/src contract/src",
    "lint:fix": "oxlint --config .oxlintrc.json --fix web/src web/scripts server/src contract/src",
    "format": "oxfmt web/src web/scripts server/src contract/src",
    "format:check": "oxfmt --check web/src web/scripts server/src contract/src"
  },
  "devDependencies": {
    "oxlint": "^1.80.0",
    "oxfmt": "^0.65.0"
  }
}
