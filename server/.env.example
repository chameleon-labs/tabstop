PORT=3000
DATABASE_URL=postgres://tabstop:tabstop@localhost:5432/tabstop
REDIS_URL=redis://localhost:6379
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
# Safe by default: only an explicit "resend" value can contact a provider.
MAIL_DRIVER=console
MAIL_FROM=Tabstop <alerts@alerts.example.test>
# Generate production's independently with: openssl rand -hex 32
ALERT_UNSUBSCRIBE_SECRET=dev-only-change-this-secret-before-production-000000000000
# Required only with MAIL_DRIVER=resend.
# RESEND_API_KEY=re_...
AUDIT_CONCURRENCY=1
# How many reverse proxies sit in front of this process. 0 (the default)
# trusts nothing; set this behind a real proxy or the rate limiter shares one
# bucket across every anonymous user.
TRUST_PROXY_HOPS=0
# The anonymous audit bucket - the cost dial, so it is the one rate limit
# that is env-configurable rather than a constant in rate-limits.ts.
AUDIT_RATE_CAPACITY=5
AUDIT_RATE_PER_HOUR=5
# Aggregate backstop: per-IP buckets bound one source each, this bounds the
# queue they all share. New audits are refused with 503 beyond it.
AUDIT_QUEUE_MAX_DEPTH=100
# Server-side bound on any single statement from the API or worker. The
# per-job timeouts bound the attempt, not the query underneath, so without
# this a statement stuck on a lock holds a pooled connection indefinitely.
# Migrations deliberately run unbounded and ignore this.
DATABASE_STATEMENT_TIMEOUT_MS=30000
