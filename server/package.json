{
  "name": "tabstop-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm run dev:services && concurrently --kill-others --names api,worker --prefix-colors blue,magenta \"pnpm run dev:api\" \"pnpm run dev:worker\"",
    "dev:services": "docker compose up -d --wait",
    "dev:api": "tsx watch --env-file=.env src/main/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/main/worker.ts",
    "build:browser": "tsc -b src/infra/audit/browser",
    "build": "pnpm build:browser && tsc -p tsconfig.build.json && node scripts/copy-vendor.mjs",
    "start": "node --env-file=.env dist/main/server.js",
    "start:worker": "node --env-file=.env dist/main/worker.js",
    "migrate": "tsx --env-file=.env src/main/scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm build:browser && tsc --noEmit",
    "vendor:axe": "node scripts/vendor-axe.mjs"
  },
  "dependencies": {
    "bullmq": "^6.0.0",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "ipaddr.js": "2.5.0",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "playwright": "^1.62.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tabstop/contract": "workspace:*",
    "@testcontainers/postgresql": "^12.0.4",
    "@testcontainers/redis": "^12.0.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.12.1",
    "concurrently": "^10.0.4",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.1"
  }
}
