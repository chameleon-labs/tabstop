{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    // `bundler`, not NodeNext: Vite resolves imports, and @tabstop/contract
    // publishes a `types` condition and no runtime entry at all, which is what
    // makes a value import of it fail at build rather than ship server code to
    // the browser.
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,
    // Relative imports name the file they mean, extension included. Two
    // consumers need that and neither of them runs a resolver: `scripts/` is
    // executed by Node as TypeScript, and Vite's native config loader - the
    // planned default - reads `vite.config.ts` and its imports as plain ESM.
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts", "vitest.setup.ts"]
}
